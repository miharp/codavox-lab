#!/bin/bash
# Point the lab at a published codavox release, installed from the harpworks
# package repository the module configures by default.
#
#   ./scripts/use-release 0.8.0
#
# The counterpart of scripts/use-snapshot. Commits the pin; then
# `vagrant destroy -f && vagrant up`, since package_ensure with a version
# installs but the lab's rule is fresh VMs per pin.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here/.." || exit 1

version="${1:?usage: use-release <version>, e.g. 0.8.0}"
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "refusing: the working tree has uncommitted changes; this script commits." >&2
  exit 1
fi
# createrepo_c names its metadata by hash, so the primary file is found through
# repomd.xml; there is no fixed primary.xml.gz to fetch. The metadata is read
# whole before it is searched: under pipefail, `grep -q` leaving early can kill
# gzip with SIGPIPE and report a version that is there as missing.
repo=https://packages.harpworks.org/rpm
primary=$(curl -fsSL "$repo/repodata/repomd.xml" 2>/dev/null \
  | grep -o 'href="repodata/[^"]*-primary\.xml\.gz"' | head -1 | cut -d'"' -f2 || true)
meta=""
[ -n "$primary" ] && meta=$(curl -fsSL "$repo/$primary" 2>/dev/null | gzip -dc 2>/dev/null || true)
if ! grep -q "<version epoch=\"0\" ver=\"$version\"" <<<"$meta"; then
  echo "codavox $version is not in the harpworks repository" >&2
  exit 1
fi
# From a package_source line (snapshot) to a package_ensure pin (release), or
# from one pin to another.
if grep -q '^codavox::package_source:' data/common.yaml; then
  sed -i '' "s|^codavox::package_source: .*|codavox::package_ensure: '$version'|" data/common.yaml
else
  sed -i '' "s|^codavox::package_ensure: .*|codavox::package_ensure: '$version'|" data/common.yaml
fi
rm -f dist/VERSION
git commit -qm "lab: run against codavox release $version" -- data/common.yaml
echo "==> pinned to codavox $version from packages.harpworks.org"
echo "==> committed; now: vagrant destroy -f && vagrant up"
